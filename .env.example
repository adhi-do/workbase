# Copy this file to ".env" and fill in real values before running the app.

# A long random string used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "production" when deploying for real (enables secure cookies, disables debug mode).
# Leave unset or "development" while working on your machine.
FLASK_ENV=development
